# -----------------------------------------------------------------------------
# CardioTrack CT-200 Document Pipeline Configuration Template
# -----------------------------------------------------------------------------

# FastAPI Setup
PROJECT_NAME="CardioTrack CT-200 Document Pipeline"

# SQLite Database Connection URL
DATABASE_URL="sqlite:///./ct200_pipeline.db"

# NoSQL Storage Option: "json" or "mongodb"
# Set to "json" to store generated QA test cases locally without external databases.
# Set to "mongodb" to connect to a running MongoDB instance.
NOSQL_STORE="json"

# MongoDB Credentials (only needed if NOSQL_STORE="mongodb")
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB="ct200_qa_testcases"

# Local JSON Store Path (only needed if NOSQL_STORE="json")
JSON_STORE_PATH="data/test_cases_store.json"

# Gemini API Key for Real LLM Generation (leave empty for portable Mock fallbacks)
GEMINI_API_KEY=""
